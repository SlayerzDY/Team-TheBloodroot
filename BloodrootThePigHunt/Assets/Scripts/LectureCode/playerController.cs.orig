    //==========================================================================================
    void shoot() {
        if (gunInv == null) { return; }
        if (gunInv[gunInvPos] == null) { return; }
        shootTimer = 0;
        gunInv[gunInvPos].ammoCurr--;
        //ScoreboardManager.GetOrCreate().AddShotFired();
