    // Function, Handle Weight
    //==========================================================================================
    public void handleWeight() {
        updatePlayerWeight();
        Inventory inv = this.GetComponent<Inventory>();
        if (inv == null) { return; }
        //if (inv.inventoryWeight >= inv.weightThreshold) { 
        //    speed = (int)(speed * (inv.weightThreshold / inv.inventoryWeight)); 
        //    if (speed <= 3) { speed = 3; }
